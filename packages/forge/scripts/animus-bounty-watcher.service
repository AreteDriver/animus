[Unit]
Description=Animus Bounty Watcher — Anthropic HackerOne intel digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/animus/packages/forge
# To enable auto-recon on new claude-code releases that touch the permission
# surface (real $$, ~$0.80-$5 per triggered sweep), set ENABLE_RECON=1 here:
#   Environment=ENABLE_RECON=1
ExecStart=%h/projects/animus/packages/forge/.venv/bin/animus-forge run workflows/bounty-watcher.yaml --var state_dir=%h/.animus/bounty_intel
StandardOutput=append:%h/.animus/bounty_intel/cron.log
StandardError=append:%h/.animus/bounty_intel/cron.log
TimeoutStartSec=1200

[Install]
WantedBy=default.target
