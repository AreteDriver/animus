[Unit]
Description=Animus Full Citizen Rotation — Architect, Conversation, Knowledge, Test
After=network.target

[Service]
Type=oneshot
User=arete
WorkingDirectory=/home/arete/projects/animus
Environment="PYTHONPATH=/home/arete/projects/animus/packages/core:/home/arete/projects/animus/packages/kernel/src:/home/arete/projects/animus/packages/types/src"
ExecStart=/bin/bash -c ' \
  /home/arete/projects/animus/packages/core/.venv/bin/python3 -m animus.autonomous-loop --citizen architect --focus codebase && \
  /home/arete/projects/animus/packages/core/.venv/bin/python3 -m animus.autonomous-loop --citizen conversation --focus conversation && \
  /home/arete/projects/animus/packages/core/.venv/bin/python3 -m animus.autonomous-loop --citizen knowledge --focus codebase && \
  /home/arete/projects/animus/packages/core/.venv/bin/python3 -m animus.autonomous-loop --citizen test --focus evaluation'
StandardOutput=journal
StandardError=journal
