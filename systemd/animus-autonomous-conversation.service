[Unit]
Description=Animus Conversation Designer — detect prompt anti-patterns
After=network.target

[Service]
Type=oneshot
User=arete
WorkingDirectory=/home/arete/projects/animus
Environment="PYTHONPATH=/home/arete/projects/animus/packages/core:/home/arete/projects/animus/packages/kernel/src:/home/arete/projects/animus/packages/types/src"
ExecStart=/home/arete/projects/animus/packages/core/.venv/bin/python3 -m animus.autonomous-loop --citizen conversation --focus conversation
StandardOutput=journal
StandardError=journal
